// Fluid Simulation using Simplified Navier-Stokes
class FluidSimulation {
    constructor(canvas) {
        this.canvas = canvas;
        this.ctx = canvas.getContext('2d', { alpha: true });
        this.resolution = 64;
        this.time = 0;
        
        this.resize();
        this.init();
        
        window.addEventListener('resize', () => this.resize());
        
        // Mouse interaction
        this.mouse = { x: 0, y: 0, px: 0, py: 0, down: false };
        window.addEventListener('mousemove', (e) => {
            this.mouse.px = this.mouse.x;
            this.mouse.py = this.mouse.y;
            this.mouse.x = e.clientX;
            this.mouse.y = e.clientY;
        });
        window.addEventListener('mousedown', () => this.mouse.down = true);
        window.addEventListener('mouseup', () => this.mouse.down = false);
    }
    
    resize() {
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
        this.width = this.canvas.width;
        this.height = this.canvas.height;
    }
    
    init() {
        this.cols = Math.floor(this.width / this.resolution);
        this.rows = Math.floor(this.height / this.resolution);
        
        // Velocity field
        this.vx = [];
        this.vy = [];
        
        // Density field for visualization
        this.density = [];
        
        for (let i = 0; i < this.cols * this.rows; i++) {
            this.vx[i] = 0;
            this.vy[i] = 0;
            this.density[i] = 0;
        }
    }
    
    getIndex(x, y) {
        x = Math.max(0, Math.min(this.cols - 1, x));
        y = Math.max(0, Math.min(this.rows - 1, y));
        return x + y * this.cols;
    }
    
    update() {
        this.time += 0.01;
        
        // Add fluid sources based on mouse movement
        if (this.mouse.down || Math.abs(this.mouse.x - this.mouse.px) > 1 || Math.abs(this.mouse.y - this.mouse.py) > 1) {
            const mx = Math.floor(this.mouse.x / this.resolution);
            const my = Math.floor(this.mouse.y / this.resolution);
            const idx = this.getIndex(mx, my);
            
            // Add velocity
            this.vx[idx] += (this.mouse.x - this.mouse.px) * 0.05;
            this.vy[idx] += (this.mouse.y - this.mouse.py) * 0.05;
            
            // Add density
            this.density[idx] = Math.min(1, this.density[idx] + 0.5);
            
            // Spread to neighbors
            const neighbors = [
                this.getIndex(mx - 1, my),
                this.getIndex(mx + 1, my),
                this.getIndex(mx, my - 1),
                this.getIndex(mx, my + 1)
            ];
            neighbors.forEach(n => {
                this.density[n] = Math.min(1, this.density[n] + 0.2);
            });
        }
        
        // Add ambient fluid motion
        const cx = Math.floor(this.cols / 2);
        const cy = Math.floor(this.rows / 2);
        const idx = this.getIndex(cx, cy);
        this.vx[idx] += Math.sin(this.time) * 0.02;
        this.vy[idx] += Math.cos(this.time * 0.7) * 0.02;
        this.density[idx] = Math.min(1, this.density[idx] + 0.01);
        
        // Diffuse velocity
        this.diffuse(this.vx, 0.00001);
        this.diffuse(this.vy, 0.00001);
        
        // Advect density
        this.advect(this.density);
        
        // Decay
        for (let i = 0; i < this.density.length; i++) {
            this.vx[i] *= 0.99;
            this.vy[i] *= 0.99;
            this.density[i] *= 0.98;
        }
    }
    
    diffuse(field, diffusion) {
        const a = diffusion * this.cols * this.rows;
        const newField = [...field];
        
        for (let k = 0; k < 2; k++) { // Simplified iterations
            for (let y = 1; y < this.rows - 1; y++) {
                for (let x = 1; x < this.cols - 1; x++) {
                    const idx = this.getIndex(x, y);
                    newField[idx] = (field[idx] + a * (
                        newField[this.getIndex(x - 1, y)] +
                        newField[this.getIndex(x + 1, y)] +
                        newField[this.getIndex(x, y - 1)] +
                        newField[this.getIndex(x, y + 1)]
                    )) / (1 + 4 * a);
                }
            }
        }
        
        for (let i = 0; i < field.length; i++) {
            field[i] = newField[i];
        }
    }
    
    advect(field) {
        const newField = [...field];
        
        for (let y = 1; y < this.rows - 1; y++) {
            for (let x = 1; x < this.cols - 1; x++) {
                const idx = this.getIndex(x, y);
                
                // Trace particle backwards
                let px = x - this.vx[idx];
                let py = y - this.vy[idx];
                
                // Clamp
                px = Math.max(0.5, Math.min(this.cols - 1.5, px));
                py = Math.max(0.5, Math.min(this.rows - 1.5, py));
                
                // Interpolate
                const x0 = Math.floor(px);
                const x1 = x0 + 1;
                const y0 = Math.floor(py);
                const y1 = y0 + 1;
                
                const sx = px - x0;
                const sy = py - y0;
                
                const idx00 = this.getIndex(x0, y0);
                const idx10 = this.getIndex(x1, y0);
                const idx01 = this.getIndex(x0, y1);
                const idx11 = this.getIndex(x1, y1);
                
                newField[idx] = 
                    (1 - sx) * ((1 - sy) * field[idx00] + sy * field[idx01]) +
                    sx * ((1 - sy) * field[idx10] + sy * field[idx11]);
            }
        }
        
        for (let i = 0; i < field.length; i++) {
            field[i] = newField[i];
        }
    }
    
    draw() {
        this.ctx.clearRect(0, 0, this.width, this.height);
        
        // Draw fluid density with color gradient
        for (let y = 0; y < this.rows; y++) {
            for (let x = 0; x < this.cols; x++) {
                const idx = this.getIndex(x, y);
                const d = this.density[idx];
                
                if (d > 0.01) {
                    const px = x * this.resolution;
                    const py = y * this.resolution;
                    
                    // Create gradient based on velocity direction
                    const speed = Math.sqrt(this.vx[idx] * this.vx[idx] + this.vy[idx] * this.vy[idx]);
                    const hue = 180 + speed * 20; // Cyan to blue based on speed
                    
                    const gradient = this.ctx.createRadialGradient(
                        px + this.resolution / 2, py + this.resolution / 2, 0,
                        px + this.resolution / 2, py + this.resolution / 2, this.resolution
                    );
                    
                    gradient.addColorStop(0, `hsla(${hue}, 70%, 60%, ${d * 0.4})`);
                    gradient.addColorStop(1, 'transparent');
                    
                    this.ctx.fillStyle = gradient;
                    this.ctx.fillRect(px, py, this.resolution, this.resolution);
                }
            }
        }
        
        // Draw velocity field lines (optional, for debugging)
        if (false) {
            this.ctx.strokeStyle = 'rgba(34, 211, 238, 0.3)';
            this.ctx.lineWidth = 1;
            
            for (let y = 0; y < this.rows; y += 2) {
                for (let x = 0; x < this.cols; x += 2) {
                    const idx = this.getIndex(x, y);
                    const px = x * this.resolution;
                    const py = y * this.resolution;
                    
                    this.ctx.beginPath();
                    this.ctx.moveTo(px, py);
                    this.ctx.lineTo(
                        px + this.vx[idx] * 10,
                        py + this.vy[idx] * 10
                    );
                    this.ctx.stroke();
                }
            }
        }
    }
    
    animate() {
        this.update();
        this.draw();
        requestAnimationFrame(() => this.animate());
    }
    
    start() {
        this.animate();
    }
}

// Initialize fluid simulation
document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('fluid-canvas');
    if (canvas) {
        const fluidSim = new FluidSimulation(canvas);
        fluidSim.start();
    }
});
